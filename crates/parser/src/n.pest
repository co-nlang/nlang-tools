// n.pest - RECONSTRUCTION 15 (SPEC_14 sync, 2026-07-05: ENGINE_SYNC #1-#7, #9-#13)
WHITESPACE = _{ " " | "\t" | "\n" | "\r\n" | "\r" }
COMMENT = _{ ";;" ~ (!("\n" | "\r\n" | "\r") ~ ANY)* }

program = { SOI ~ WHITESPACE* ~ (field ~ field_sep?)* ~ EOI }
// Top-level expression entry: must consume the whole input (no silent trailing drop).
// Bare `expr` is used nested; this wrapper is for parse_expr_only only.
expr_toplevel = { SOI ~ expr ~ EOI }
field_sep = _{ "," | ";" | WHITESPACE+ }

ident = @{ (XID_START | "_") ~ (XID_CONTINUE | "_" | "-")* }
numeric = @{ ASCII_DIGIT+ }

prefix_type    = @{ "@" }
prefix_logic   = @{ "/" }
prefix_meta    = @{ "%" }
prefix_system  = @{ "~%" }
prefix_local   = @{ "~" }

// Structured prefixes (SPEC_14 §2.2): eight legal forms —
// (none), @, /, %, ~%, ~, ~@, ~/. Free stacking (e.g. %@a) is rejected.
prefix = @{ prefix_system | prefix_meta | (prefix_local ~ (prefix_type | prefix_logic)?) | prefix_type | prefix_logic }

numeric_key = @{ numeric }

named_key = @{
    ( prefix ~ ident )
    | ident
    | numeric_key
}

quoted_key = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

// interp_str is not a legal field key (SYNTAX_03 §4.10); tag keys are canonical.
// LHS definition keys: absolute `_.` ok; parent `^` abolished (SYNTAX_03 §4.4 Q3
// — caret handover). RHS still uses full `anchored_path` via primary/expr.
field_root_path = { anchor_root ~ path_segments? }
field_key = { anon_set | field_root_path | path | named_key | quoted_key | tag }
field = { (field_key ~ ":" ~ expr) | spread_expr }

expr = { morphism_expr }
morphism_expr = { ternary_expr ~ (!field_start ~ morphism_op ~ ternary_expr)* }
morphism_op = { "->" }
ternary_expr  = { pipe_expr ~ (!field_start ~ "?" ~ pipe_expr ~ ":" ~ pipe_expr)? }
pipe_expr = { join_expr ~ (!field_start ~ pipe_op ~ join_expr)* }
pipe_op = { "|>" }
join_expr = { cmp_expr ~ (!field_start ~ join_op ~ cmp_expr)* }
join_op = { "|" | "\\" }
// Level 11: comparison — non-chaining; & (L10) binds tighter than cmp (anti-C, SPEC_14 §2.3)
cmp_expr = { meet_expr ~ (!field_start ~ cmp_op ~ meet_expr)? }
// two families: lattice/set < <= = >= > (non-collapsing) vs atomic == != (collapsing);
// <=> direction probe (returns tag union; SYNTAX_10) — longest match first
cmp_op = { "<=>" | "<=" | ">=" | "==" | "!=" | "=" | "<" | ">" }
meet_expr = { add_expr ~ (!field_start ~ meet_op ~ add_expr)* }
meet_op = { "&" }
add_expr = { mul_expr ~ (!field_start ~ add_op ~ mul_expr)* }
add_op = { "+" | "-" }
mul_expr = { infix_expr ~ (!field_start ~ mul_op ~ infix_expr)* }
mul_op = @{ "*" | ("/" ~ !ident) | ("%" ~ !ident) }
// Level 7: infix logic — `a /f b` (no space between / and ident); `a / b` is division
infix_expr = { apply_expr ~ (!field_start ~ logic_infix ~ apply_expr)* }
logic_infix = @{ "/" ~ ident }
// !logic_infix: `a /f b` must reach the L7 infix level — juxtaposition may not
// swallow /f as an operand (authority fix, reverse-adopted into SPEC_14 2026-07-05)
apply_expr = { unary_expr ~ (!field_start ~ !add_op ~ !mul_op ~ !cmp_op ~ !logic_infix ~ unary_expr)* }
unary_expr = { (unary_op ~ unary_expr) | spread_expr | type_ann_expr }
unary_op = { "!" }
spread_expr = { "..." ~ type_ann_expr }
type_ann_expr = { postfix_expr ~ (!field_start ~ type_ann_op ~ postfix_expr)* }
type_ann_op = { "@" }


field_start = _{ field_key ~ ":" }

postfix_expr = { primary ~ postfix_op* }
postfix_op = { ("." ~ named_key) | ("[" ~ expr ~ "]") }

primary = {
    range
    | complex_lit
    | context
    | structural
    | tuple
    | "(" ~ expr ~ ")"
    | combo
    | cocoon
    | anon_set
    | poset_lit
    | list
    | interp_str
    | anchored_path
    | atom
    | path
}

range = {
    (range_start ~ ".." ~ (!field_start ~ range_end)? ~ (".." ~ !field_start ~ range_step)?)
    | (".." ~ (!field_start ~ range_end)? ~ (".." ~ !field_start ~ range_step)?)
}
range_start = { range_bound }
range_end = { range_bound }
range_step = { range_bound }
range_bound = { atom | path }

context = { "$" }
// crystal brackets: double angles (2026-06 revision); << longest-matches before <
structural = { "<<" ~ expr ~ ">>" }
combo = { "{" ~ WHITESPACE* ~ ( field ~ field_sep? )* ~ "}" }
cocoon = { "{{" ~ WHITESPACE* ~ ( field ~ field_sep? )* ~ "}}" }
// Empty body allowed: `@{}` ≡ `_|_` (SYNTAX_02 §4.1 / SYNTAX_04 §4.3)
anon_set = { "@{" ~ expr? ~ "}" }

// Poset literal (SYNTAX_10; discussion/008): bare order chains live ONLY here
poset_lit   = { "#{" ~ WHITESPACE* ~ (order_chain ~ field_sep?)* ~ "}" }
order_chain = { poset_node ~ (order_op ~ poset_node)+ }
order_op    = { "<=" | ">=" | "=" | "<" | ">" }
poset_node  = { tag_start | tag_end | tag }

// tuple is delimited by "at least one separator": (x) is grouping, (x,) is a 1-tuple
tuple = { "(" ~ WHITESPACE* ~ expr ~ list_sep ~ (expr ~ (list_sep ~ expr)* ~ list_sep?)? ~ WHITESPACE* ~ ")" }
list = { "[" ~ WHITESPACE* ~ (expr ~ (list_sep ~ expr)* ~ list_sep?)? ~ WHITESPACE* ~ "]" }
list_sep = _{ "," | ";" }

atom = {
    bottom
    | tag_start
    | tag_end
    | top
    | unit
    | float_lit
    | int_lit
    | regex_lit
    | path_lit
    | bytes_lit
    | uri_lit
    | time_lit
    | multiline_str
    | str_lit
    | tag
}

int_lit = @{ "-"? ~ numeric }
float_lit = @{
    "-"? ~ numeric ~ "." ~ numeric
    ~ ( ("e" | "E") ~ ("+" | "-")? ~ numeric )?
}
// trailing !(XID_CONTINUE | "-") guard: `io`/`it`/`i-1` are idents, not
// complex-then-apply (2026-07-06 fix, back-ported to SPEC_14)
complex_lit = @{
    ( "-"? ~ numeric ~ ("." ~ numeric)? ~ ( ("e" | "E") ~ ("+" | "-")? ~ numeric )? )
    ~ ("+" | "-") ~ numeric ~ ("." ~ numeric)? ~ ( ("e" | "E") ~ ("+" | "-")? ~ numeric )? ~ "i" ~ !(XID_CONTINUE | "-")
    | "-"? ~ numeric ~ ("." ~ numeric)? ~ ( ("e" | "E") ~ ("+" | "-")? ~ numeric )? ~ "i" ~ !(XID_CONTINUE | "-")
    | "-"? ~ "i" ~ !(XID_CONTINUE | "-")
}

bottom = { "_|_" }
tag_start = { "#_|_" }
tag_end = { "#_" }
top = { "_" }
unit = { "(" ~ ")" }
regex_lit  = @{ "r\"" ~ (!"\"" ~ ANY)* ~ "\"" }
path_lit   = @{ "p\"" ~ (!"\"" ~ ANY)* ~ "\"" }
bytes_lit  = @{ "b\"" ~ (!"\"" ~ ANY)* ~ "\"" }
uri_lit    = @{ "u\"" ~ (!"\"" ~ ANY)* ~ "\"" }
time_lit   = @{ "t\"" ~ (!"\"" ~ ANY)* ~ "\"" }
multiline_str = @{
    "\"\"\"" ~ ( ("\\" ~ "\"\"\"") | (!"\"\"\"" ~ ANY) )* ~ "\"\"\""
}
str_lit = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
tag = @{ "#" ~ !("_|_" | "_" ~ !ident) ~ ident }

interp_str = ${ "`" ~ interp_part* ~ "`" }
interp_part = { interp_expr | interp_literal }
interp_expr    = !{ "${" ~ expr ~ "}" }
interp_literal = @{ (!("`" | "${") ~ ANY)+ }

// anchored: segments optional — bare `_.` is the root universe, `^.` one parent up.
// Tried before `atom` in primary (otherwise top `_` shadows `_.`); bare paths after.
anchored_path = { (anchor_root | anchor_parent) ~ path_segments? }
path = { path_segments }
path_segments = { (named_key | tag_start | tag_end | tag) ~ ( "." ~ (named_key | tag_start | tag_end | tag) )* }
anchor_root = { "_." }
anchor_parent = @{ "^"+ ~ "." }
