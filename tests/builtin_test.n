my_list: { 0: 10, 1: 20, 2: 30 }

;; 測試 len
len_res: ~%List./len my_list

;; 測試 at
at_res: ~%List./at { 0: my_list, 1: 1 }

;; 測試 concat
list_a: { 0: 1 }
list_b: { 0: 2, 1: 3 }
concat_res: ~%List./concat { 0: list_a, 1: list_b }

;; 測試 Math
math_sub: ~%Math./sub { 0: 10, 1: 3 }
math_mul: ~%Math./mul { 0: 5, 1: 4 }
math_div: ~%Math./div { 0: 20, 1: 4 }
math_pow: ~%Math./pow { 0: 2, 1: 3 }
math_abs: -5 |> ~%Math./abs

;; 測試 Cond
cond_if: ~%Cond./if { 0: #true, 1: (_ -> 100), 2: (_ -> 200) }
cond_if_false: ~%Cond./if { 0: #false, 1: (_ -> 100), 2: (_ -> 200) }

cond_cond: ~%Cond./cond [
    { 0: #false, 1: (_ -> 1) },
    { 0: #true, 1: (_ -> 2) },
    { 0: #true, 1: (_ -> 3) }
]

test_res: math_sub == 7 & math_mul == 20 & math_div == 5 & math_pow == 8 & math_abs == 5 & cond_if == 100 & cond_if_false == 200 & cond_cond == 2
