;; PENDING(2026-07-12 語料清理移入)——兩測皆卡在已記帳的引擎缺口:
;; 1. test_canonical_order:combo 等值於兩個比較家族均 #false
;;    (即使綁定後完全相同;ENGINE_SYNC 缺口 G1)。向量不遷就實作,故移此。
;; 2. test_fuel_exhaustion:runaway 態射現走 fuel 通道,%type 得 #conflict
;;    而非 #divergent(cause 精化為既有隊列項,ENGINE_SYNC 缺口 G3)。
;; 測試語義規範化與 MBU 計費

;; 1. 語義規範化 (欄位重排)
~messy: {
    z: 3,
    a: 1,
    b: 2
}
test_canonical_order: ~messy == { a: 1, b: 2, z: 3 }

;; 2. MBU 計費與燃料耗盡
/recursive: x -> /recursive (x + 1)
~exhausted: (/recursive 1).%type
test_fuel_exhaustion: ~exhausted == #divergent
